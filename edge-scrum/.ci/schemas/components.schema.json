{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["components"],
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "projects"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "projects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["project_id", "project_key"],
              "additionalProperties": false,
              "properties": {
                "project_id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "project_key": {
                  "type": "string",
                  "minLength": 1
                },
                "component_id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
