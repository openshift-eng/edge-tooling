{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["labels"],
  "additionalProperties": false,
  "properties": {
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^:]+:.+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
