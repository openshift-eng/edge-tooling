{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["boards"],
  "additionalProperties": false,
  "properties": {
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "filter_id", "properties"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["scrum", "kanban"]
          },
          "filter_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
