{
  "permissions": {
    "allow": [
      "Edit(//tmp/sprint-health-*/**)",
      "Edit(//tmp/release-health-*/**)",
      "Write(//tmp/sprint-health-*/**)",
      "Write(//tmp/release-health-*/**)",
      "Edit(.reports/**)",
      "Write(.reports/**)",
      "Bash(mkdir -p /tmp/sprint-health-*)",
      "Bash(mkdir -p /tmp/release-health-*)",
      "Bash(test -n * && [[ * == /tmp/sprint-health-* ]] *)",
      "Bash(test -n * && [[ * == /tmp/release-health-* ]] *)",
      "Bash(rm -rf -- /tmp/sprint-health-*)",
      "Bash(rm -rf -- /tmp/release-health-*)",
      "Bash(python3 plugins/edge-scrum/bin/*)"
    ]
  }
}
